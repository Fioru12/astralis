{
  "name": "astralis",
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:auto": "node dev-server.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:bundle": "node scripts/check-bundle-size.js",
    "test:e2e": "playwright test",
    "test:e2e:offline": "playwright test --config=playwright.offline.config.js",
    "prepare": "husky install",
    "serve-dist": "npx http-server dist -p 5000",
    "convert-textures": "node convert_textures.js",
    "roadmap": "node ROADMAP.js",
    "status": "node STATUS.js"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "husky": "^8.0.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.9.8",
    "sharp": "^0.35.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ]
  }
}
